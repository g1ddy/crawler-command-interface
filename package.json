{
  "name": "crawler-command-ui",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "npm run build:live",
    "build:live": "bash scripts/build-verified.sh && node scripts/write-build-provenance.mjs live",
    "build:pages": "vite build --config vite.pages.config.ts && node scripts/write-build-provenance.mjs pages",
    "verify": "npm run lint && npm run test:unit && npm run build:live && npm run test:rendered && npm run build:pages && npm run test:artifacts",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build:live && npm run test:unit && npm run test:rendered",
    "test:unit": "node --experimental-strip-types --test tests/countdowns.test.mjs tests/projection.test.mjs tests/raw-floor-adapter.test.mjs tests/persistence.test.mjs",
    "test:rendered": "node --experimental-strip-types --test tests/rendered-html.test.mjs",
    "test:artifacts": "node --test tests/build-targets.test.mjs",
    "test:pages:custom-base": "npm run build:live && PAGES_BASE_PATH=/ npm run build:pages && PAGES_BASE_PATH=/ npm run test:artifacts && npm run build:pages && npm run test:artifacts",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern dist-pages --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "analyze:architecture": "maritime analyze --source app --source src --output .maritime"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Crawler Command Interface"
}
