{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g1ddy.github.io/crawler-command-interface/schema/modeling-decision.v1.schema.json",
  "title": "Crawler Modeling Decision v1",
  "description": "Architectural modeling decisions for external research claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisions"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "schemaVersion": {
      "const": "crawler-modeling/v1"
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    }
  },
  "$defs": {
    "claimId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]+$"
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "disposition",
        "rationale"
      ],
      "properties": {
        "claimId": {
          "$ref": "#/$defs/claimId"
        },
        "disposition": {
          "enum": [
            "promote",
            "review",
            "ledger_only"
          ]
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "domain",
            "concept"
          ],
          "properties": {
            "domain": {
              "type": "string",
              "minLength": 1
            },
            "concept": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "observationMapping": {
          "$ref": "#/$defs/observationMapping"
        }
      },
      "if": {
        "properties": {
          "disposition": {
            "const": "promote"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "target"
            ]
          },
          {
            "required": [
              "observationMapping"
            ]
          }
        ]
      }
    },
    "observationMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "anchor",
        "payload"
      ],
      "properties": {
        "kind": {
          "enum": [
            "countdown-remaining",
            "crawler-condition",
            "crawler-attributes",
            "xp-progress",
            "broadcast-metrics",
            "floor-metrics",
            "inventory-state",
            "equipment-state"
          ]
        },
        "anchor": {
          "type": "object",
          "required": [
            "kind"
          ],
          "oneOf": [
            {
              "properties": {
                "kind": {
                  "const": "event-id"
                },
                "eventId": {
                  "type": "string"
                }
              },
              "required": [
                "eventId"
              ],
              "additionalProperties": false
            },
            {
              "properties": {
                "kind": {
                  "const": "claim-id"
                },
                "claimId": {
                  "$ref": "#/$defs/claimId"
                }
              },
              "required": [
                "claimId"
              ],
              "additionalProperties": false
            }
          ]
        },
        "payload": {
          "type": "object"
        }
      }
    }
  }
}