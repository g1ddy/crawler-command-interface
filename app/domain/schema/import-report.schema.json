{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g1ddy.github.io/crawler-command-interface/schema/import-report.v1.schema.json",
  "title": "Crawler Import Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "summary",
    "unknowns",
    "eventStubs",
    "observationStubs",
    "manualMappings",
    "dispositions",
    "outcomes",
    "diagnostics",
    "claims"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "crawler-import-report/v1"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputClaims",
        "unknowns",
        "generatedStubs",
        "reusedRecords",
        "manualMappings",
        "dispositions",
        "outcomes",
        "diagnostics"
      ],
      "properties": {
        "inputClaims": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "event", "observation", "state"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "event": { "type": "integer", "minimum": 0 },
            "observation": { "type": "integer", "minimum": 0 },
            "state": { "type": "integer", "minimum": 0 }
          }
        },
        "unknowns": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "event", "observation", "state", "unresolved"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "event": { "type": "integer", "minimum": 0 },
            "observation": { "type": "integer", "minimum": 0 },
            "state": { "type": "integer", "minimum": 0 },
            "unresolved": { "type": "integer", "minimum": 0 }
          }
        },
        "generatedStubs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["events", "observations"],
          "properties": {
            "events": { "type": "integer", "minimum": 0 },
            "observations": { "type": "integer", "minimum": 0 }
          }
        },
        "reusedRecords": {
          "type": "object",
          "additionalProperties": false,
          "required": ["events", "observations"],
          "properties": {
            "events": { "type": "integer", "minimum": 0 },
            "observations": { "type": "integer", "minimum": 0 }
          }
        },
        "manualMappings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["events", "observations"],
          "properties": {
            "events": { "type": "integer", "minimum": 0 },
            "observations": { "type": "integer", "minimum": 0 }
          }
        },
        "dispositions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["promote", "review", "ledger_only", "missing"],
          "properties": {
            "promote": { "type": "integer", "minimum": 0 },
            "review": { "type": "integer", "minimum": 0 },
            "ledger_only": { "type": "integer", "minimum": 0 },
            "missing": { "type": "integer", "minimum": 0 }
          }
        },
        "outcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["compiled", "reused", "unresolved", "rejected", "not_applicable"],
          "properties": {
            "compiled": { "type": "integer", "minimum": 0 },
            "reused": { "type": "integer", "minimum": 0 },
            "unresolved": { "type": "integer", "minimum": 0 },
            "rejected": { "type": "integer", "minimum": 0 },
            "not_applicable": { "type": "integer", "minimum": 0 }
          }
        },
        "diagnostics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId", "text", "status"],
        "properties": {
          "claimId": { "type": "string" },
          "text": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "eventStubs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId", "recordId", "typePopulated"],
        "properties": {
          "claimId": { "type": "string" },
          "recordId": { "type": "string" },
          "typePopulated": { "type": "boolean" }
        }
      }
    },
    "observationStubs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId", "recordId", "kind", "eventId", "outcome"],
        "properties": {
          "claimId": { "type": "string" },
          "recordId": { "type": "string" },
          "kind": { "type": "string" },
          "eventId": { "type": "string" },
          "outcome": { "type": "string" }
        }
      }
    },
    "manualMappings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "observations"],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claimId", "recordId", "mappedType"],
            "properties": {
              "claimId": { "type": "string" },
              "recordId": { "type": "string" },
              "mappedType": { "type": "string" }
            }
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claimId", "recordId", "mappedKind", "outcome"],
            "properties": {
              "claimId": { "type": "string" },
              "recordId": { "type": "string" },
              "mappedKind": { "type": "string" },
              "outcome": { "type": "string" }
            }
          }
        }
      }
    },
    "dispositions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promote", "review", "ledger_only", "missing"],
      "properties": {
        "promote": { "type": "array", "items": { "type": "string" } },
        "review": { "type": "array", "items": { "type": "string" } },
        "ledger_only": { "type": "array", "items": { "type": "string" } },
        "missing": { "type": "array", "items": { "type": "string" } }
      }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiled", "reused", "unresolved", "rejected", "not_applicable"],
      "properties": {
        "compiled": { "type": "array", "items": { "type": "string" } },
        "reused": { "type": "array", "items": { "type": "string" } },
        "unresolved": { "type": "array", "items": { "type": "string" } },
        "rejected": { "type": "array", "items": { "type": "string" } },
        "not_applicable": { "type": "array", "items": { "type": "string" } }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "claimId"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "claimId": { "type": "string" },
          "recordId": { "type": "string" }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "disposition", "outcome"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "disposition": {
            "type": "string",
            "enum": ["promote", "review", "ledger_only", "missing"]
          },
          "outcome": {
            "type": "string",
            "enum": ["compiled", "reused", "unresolved", "rejected", "not_applicable"]
          },
          "recordId": { "type": "string" }
        }
      }
    }
  }
}
