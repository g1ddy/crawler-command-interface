{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g1ddy.github.io/crawler-command-interface/schema/crawler-floor-raw.v2.schema.json",
  "title": "Crawler Raw Floor Authoring v2",
  "description": "Source-backed floor authoring with heterogeneous point-in-time observations. Reuses the v1 event/catalog contract while replacing the countdown-only observation union.",
  "$ref": "https://g1ddy.github.io/crawler-command-interface/schema/crawler-floor-raw.v1.schema.json",
  "$defs": {
    "observationV2": {
      "oneOf": [
        { "$ref": "#/$defs/countdownRemaining" },
        { "$ref": "#/$defs/crawlerCondition" },
        { "$ref": "#/$defs/crawlerAttributes" },
        { "$ref": "#/$defs/xpProgress" },
        { "$ref": "#/$defs/broadcastMetrics" },
        { "$ref": "#/$defs/inventoryState" },
        { "$ref": "#/$defs/equipmentState" }
      ]
    },
    "evidenceArray": { "type": "array", "minItems": 1, "items": { "$ref": "https://g1ddy.github.io/crawler-command-interface/schema/crawler-floor-raw.v1.schema.json#/$defs/evidence" } },
    "countdownRemaining": { "type": "object", "additionalProperties": false, "required": ["id","kind","eventId","countdownId","remainingSeconds","evidence"], "properties": { "id": { "$ref": "https://g1ddy.github.io/crawler-command-interface/schema/crawler-floor-raw.v1.schema.json#/$defs/id" }, "kind": { "const": "countdown-remaining" }, "eventId": { "$ref": "https://g1ddy.github.io/crawler-command-interface/schema/crawler-floor-raw.v1.schema.json#/$defs/id" }, "countdownId": { "$ref": "https://g1ddy.github.io/crawler-command-interface/schema/crawler-floor-raw.v1.schema.json#/$defs/id" }, "remainingSeconds": { "$ref": "https://g1ddy.github.io/crawler-command-interface/schema/crawler-floor-raw.v1.schema.json#/$defs/nonNegativeInteger" }, "evidence": { "$ref": "#/$defs/evidenceArray" }, "note": { "type": "string", "maxLength": 1000 } } },
    "crawlerCondition": { "type": "object", "additionalProperties": false, "required": ["id","kind","eventId","evidence"], "properties": { "id": { "$ref": "https://g1ddy.github.io/crawler-command-interface/schema/crawler-floor-raw.v1.schema.json#/$defs/id" }, "kind": { "const": "crawler-condition" }, "eventId": { "$ref": "https://g1ddy.github.io/crawler-command-interface/schema/crawler-floor-raw.v1.schema.json#/$defs/id" }, "currentHealth": { "type": "number", "minimum": 0 }, "maxHealth": { "type": "number", "minimum": 0 }, "currentMana": { "type": "number", "minimum": 0 }, "maxMana": { "type": "number", "minimum": 0 }, "currentStamina": { "type": "number", "minimum": 0 }, "maxStamina": { "type": "number", "minimum": 0 }, "evidence": { "$ref": "#/$defs/evidenceArray" }, "note": { "type": "string", "maxLength": 1000 } }, "anyOf": [{"required":["currentHealth"]},{"required":["maxHealth"]},{"required":["currentMana"]},{"required":["maxMana"]},{"required":["currentStamina"]},{"required":["maxStamina"]}] },
    "crawlerAttributes": { "type": "object", "additionalProperties": false, "required": ["id","kind","eventId","attributes","evidence"], "properties": { "id": { "$ref": "https://g1ddy.github.io/crawler-command-interface/schema/crawler-floor-raw.v1.schema.json#/$defs/id" }, "kind": { "const": "crawler-attributes" }, "eventId": { "$ref": "https://g1ddy.github.io/crawler-command-interface/schema/crawler-floor-raw.v1.schema.json#/$defs/id" }, "attributes": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "number" } }, "evidence": { "$ref": "#/$defs/evidenceArray" }, "note": { "type": "string", "maxLength": 1000 } } },
    "xpProgress": { "type": "object", "additionalProperties": false, "required": ["id","kind","eventId","evidence"], "properties": { "id": { "$ref": "https://g1ddy.github.io/crawler-command-interface/schema/crawler-floor-raw.v1.schema.json#/$defs/id" }, "kind": { "const": "xp-progress" }, "eventId": { "$ref": "https://g1ddy.github.io/crawler-command-interface/schema/crawler-floor-raw.v1.schema.json#/$defs/id" }, "xp": { "type": "number", "minimum": 0 }, "maxXp": { "type": "number", "minimum": 0 }, "level": { "type": "integer", "minimum": 1 }, "evidence": { "$ref": "#/$defs/evidenceArray" }, "note": { "type": "string", "maxLength": 1000 } }, "anyOf": [{"required":["xp"]},{"required":["maxXp"]},{"required":["level"]}] },
    "broadcastMetrics": { "type": "object", "additionalProperties": false, "required": ["id","kind","eventId","evidence"], "properties": { "id": { "$ref": "https://g1ddy.github.io/crawler-command-interface/schema/crawler-floor-raw.v1.schema.json#/$defs/id" }, "kind": { "const": "broadcast-metrics" }, "eventId": { "$ref": "https://g1ddy.github.io/crawler-command-interface/schema/crawler-floor-raw.v1.schema.json#/$defs/id" }, "viewers": { "type": "integer", "minimum": 0 }, "followers": { "type": "integer", "minimum": 0 }, "fameRank": { "type": "string", "minLength": 1 }, "sponsorInterest": { "type": "boolean" }, "metrics": { "type": "object", "minProperties": 1, "additionalProperties": true }, "evidence": { "$ref": "#/$defs/evidenceArray" }, "note": { "type": "string", "maxLength": 1000 } }, "anyOf": [{"required":["viewers"]},{"required":["followers"]},{"required":["fameRank"]},{"required":["sponsorInterest"]},{"required":["metrics"]}] },
    "inventoryState": { "type": "object", "additionalProperties": false, "required": ["id","kind","eventId","itemInstanceId","evidence"], "properties": { "id": { "$ref": "https://g1ddy.github.io/crawler-command-interface/schema/crawler-floor-raw.v1.schema.json#/$defs/id" }, "kind": { "const": "inventory-state" }, "eventId": { "$ref": "https://g1ddy.github.io/crawler-command-interface/schema/crawler-floor-raw.v1.schema.json#/$defs/id" }, "itemInstanceId": { "$ref": "https://g1ddy.github.io/crawler-command-interface/schema/crawler-floor-raw.v1.schema.json#/$defs/id" }, "present": { "type": "boolean" }, "quantity": { "$ref": "https://g1ddy.github.io/crawler-command-interface/schema/crawler-floor-raw.v1.schema.json#/$defs/quantity" }, "isEquipped": { "type": "boolean" }, "evidence": { "$ref": "#/$defs/evidenceArray" }, "note": { "type": "string", "maxLength": 1000 } }, "anyOf": [{"required":["present"]},{"required":["quantity"]},{"required":["isEquipped"]}] },
    "equipmentState": { "type": "object", "additionalProperties": false, "required": ["id","kind","eventId","slot","itemInstanceId","evidence"], "properties": { "id": { "$ref": "https://g1ddy.github.io/crawler-command-interface/schema/crawler-floor-raw.v1.schema.json#/$defs/id" }, "kind": { "const": "equipment-state" }, "eventId": { "$ref": "https://g1ddy.github.io/crawler-command-interface/schema/crawler-floor-raw.v1.schema.json#/$defs/id" }, "slot": { "type": "string", "minLength": 1 }, "itemInstanceId": { "oneOf": [{ "$ref": "https://g1ddy.github.io/crawler-command-interface/schema/crawler-floor-raw.v1.schema.json#/$defs/id" }, { "type": "null" }] }, "evidence": { "$ref": "#/$defs/evidenceArray" }, "note": { "type": "string", "maxLength": 1000 } } }
  }
}
