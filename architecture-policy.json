{
  "publicFeatureContract": "src/features/<feature>/public.ts",
  "featureApplicationContracts": [
    "src/application/crawler-action-contracts.ts"
  ],
  "runtimeRoots": [
    "app/layout.tsx",
    "app/page.tsx",
    "src/CrawlerApp.tsx",
    "src/main.pages.tsx",
    "worker/index.ts"
  ],
  "nodeAuthoringModules": [
    "app/domain/compiler.ts",
    "app/domain/raw-compiler.ts",
    "app/domain/raw-loader.ts"
  ],
  "rules": [
    { "name": "domain-must-not-depend-on-ui", "from": "^app/domain/", "to": "^src/" },
    { "name": "shared-must-remain-generic", "from": "^src/shared/", "to": "^(src/(features|shell|application)/|app/)" },
    { "name": "features-must-not-depend-on-shell", "from": "^src/features/", "to": "^src/shell/" },
    { "name": "application-must-not-depend-on-ui", "from": "^src/application/", "to": "^(src/(features|shell)/|app/(?!domain/))" },
    { "name": "application-must-not-depend-on-react", "from": "^src/application/", "external": "^(react|react-dom)(/|$)" },
    { "name": "shared-browser-must-not-depend-on-host", "from": "^src/", "to": "^app/(?!domain/)" }
  ]
}
